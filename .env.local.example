# ========================================================
# Project BARGAIN — LLM API Configuration
# ========================================================

# google / openai / auto
BARGAIN_LLM_PROVIDER=google

# 1. Google Gemini API を使用する場合
# https://aistudio.google.com/ で取得したAPIキーを設定
GOOGLE_API_KEY=your_google_api_key_here
BARGAIN_GOOGLE_MODEL=gemini-3.6-flash

# 2. OpenAI API を使用する場合
# https://platform.openai.com/api-keys で取得したAPIキーを設定
OPENAI_API_KEY=your_openai_api_key_here

# 3. PostgreSQL 永続化（未設定時は開発用インメモリストアへフォールバック）
DATABASE_URL=postgresql://user:password@localhost:5432/bargain
# 64桁hex、または十分に長いランダム文字列。買い手・売り手の非公開状態を暗号化します。
BARGAIN_PRIVATE_STATE_KEY=replace_with_a_long_random_secret

# ※ APIキーが設定されていない場合は、内蔵のゲーム理論・市場相場戦略エンジンが自動的にフォールバック動作します。
