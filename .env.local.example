# ========================================================
# Project BARGAIN — LLM API Configuration
# ========================================================

# google / openai / auto
BARGAIN_LLM_PROVIDER=google
BARGAIN_ENV=local
# Set true only for local/staging contract tests that intentionally send demo headers.
BARGAIN_ENABLE_DEMO_HEADERS=false

# 1. Google Gemini API を使用する場合
# https://aistudio.google.com/ で取得したAPIキーを設定
GOOGLE_API_KEY=your_google_api_key_here
BARGAIN_GOOGLE_MODEL=gemini-3.6-flash

# 2. OpenAI API を使用する場合
# https://platform.openai.com/api-keys で取得したAPIキーを設定
OPENAI_API_KEY=your_openai_api_key_here

# 3. PostgreSQL 永続化（開発時のみ未設定ならインメモリストアへフォールバック。本番は必須）
DATABASE_URL=postgresql://user:password@localhost:5432/bargain
# 64桁hex、または十分に長いランダム文字列。買い手・売り手の非公開状態を暗号化します。
BARGAIN_PRIVATE_STATE_KEY=replace_with_a_long_random_secret
# Actor Cookie署名用。本番では必ずランダムな長い秘密値を設定します。
BARGAIN_SESSION_SECRET=replace_with_another_long_random_secret

# ※ APIキーが設定されていない場合は、内蔵のゲーム理論・市場相場戦略エンジンが自動的にフォールバック動作します。

# --- Commit Gate (irreversible purchase) ---
# Optional separate secret for signed approval grants (32+ chars). Falls back to BARGAIN_SESSION_SECRET.
BARGAIN_GRANT_SECRET=replace_with_a_third_long_random_secret
# Operator token: kill switch, stop, reject (operators can halt, never spend).
BARGAIN_OPERATOR_TOKEN=replace_with_operator_token
# Set to "engaged" to halt all agent steps and purchases at deploy time.
BARGAIN_KILL_SWITCH=released
# Optional: send approved purchases to a real order system (HMAC-signed, Idempotency-Key = intent hash).
# BARGAIN_EFFECT_WEBHOOK_URL=https://orders.example.com/bargain
# BARGAIN_EFFECT_WEBHOOK_SECRET=replace_with_webhook_signing_secret
