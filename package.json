{
  "name": "project-bargain",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "preview:staging": "opennextjs-cloudflare build && opennextjs-cloudflare preview --env staging",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy -- --keep-vars",
    "deploy:staging": "opennextjs-cloudflare build && opennextjs-cloudflare deploy --env staging -- --keep-vars",
    "deploy:production": "opennextjs-cloudflare build && opennextjs-cloudflare deploy --env production -- --keep-vars",
    "cf:check": "opennextjs-cloudflare build && wrangler deploy --env staging --dry-run",
    "cf:dry-run": "opennextjs-cloudflare build && wrangler deploy --env staging --dry-run",
    "cf:typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts --include-runtime=false",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "tsx test/run_all_tests.ts",
    "audit": "npm audit --omit=dev",
    "catalog:sync": "node scripts/sync-curated-catalog.mjs",
    "catalog:verify": "tsx test/catalog.test.ts"
  },
  "dependencies": {
    "@langchain/core": "1.2.8",
    "@langchain/google-genai": "2.2.0",
    "@langchain/langgraph": "1.4.10",
    "@langchain/langgraph-checkpoint": "1.1.3",
    "@langchain/openai": "1.5.8",
    "@opennextjs/cloudflare": "^1.20.2",
    "@radix-ui/colors": "^3.0.0",
    "@radix-ui/react-accordion": "^1.2.2",
    "@radix-ui/react-dialog": "^1.1.4",
    "@radix-ui/react-dropdown-menu": "^2.1.4",
    "@radix-ui/react-popover": "^1.1.4",
    "@radix-ui/react-slider": "^1.2.2",
    "@radix-ui/react-switch": "^1.1.2",
    "@radix-ui/react-tabs": "^1.1.2",
    "@radix-ui/react-tooltip": "^1.1.6",
    "canvas-confetti": "^1.9.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.469.0",
    "motion": "^13.1.0",
    "next": "16.3.1",
    "pg": "^8.23.0",
    "pg-cloudflare": "^1.4.0",
    "react": "19.2.8",
    "react-aria-components": "^1.20.0",
    "react-dom": "19.2.8",
    "sonner": "^2.0.8",
    "tailwind-merge": "^2.6.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^20.17.10",
    "@types/pg": "^8.23.1",
    "@types/react": "19.2.8",
    "@types/react-dom": "19.2.3",
    "autoprefixer": "^10.4.20",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.1",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "wrangler": "^4.124.0"
  }
}
